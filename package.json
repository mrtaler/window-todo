{
  "name": "window-todo",
  "private": true,
  "scripts": {
    "build": "node scripts/build.js",
    "pack": "node scripts/package.js",
    "demo": "node dist/codex/demo.cjs",
    "codex": "node dist/codex/launch.cjs",
    "typecheck": "tsc -p tsconfig.json",
    "validate": "claude plugin validate .",
    "test:claude": "claude plugin test .",
    "test:shared": "node --test .test-build/shared/*.spec.js",
    "test:codex": "node --test codex/test.spec.cjs",
    "test:release": "node --test scripts/update-version.test.cjs",
    "test:package": "node scripts/test-package.js",
    "test": "npm run test:shared && npm run test:claude && npm run test:codex && npm run test:release",
    "check": "npm run typecheck && npm run build && npm run validate && npm run test && npm run test:package"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  }
}
